# one_earth_solutions - Common Action - first draft 0.1.0
# Ontology IRI: https://www.in2use.com/one_earth_solutions
# Entity namespace: https://www.in2use.com/one_earth_solutions/
# 3 Pillars; 12 Subpillars; 76 Solutions; 7 Themes; 7 Levers.
# All 105 entries are category individuals. Open this file directly in Protege.
# No imports or catalog file are required. No process ontology is included.
# Labels follow IRI suffixes with underscores replaced by spaces; original
# source headings are retained as English dcterms:title values.
# Categories can overlap in application: disjoint category roles do not make
# solution activities or the projects implementing them mutually exclusive.
#
# Query all solution categories under Nature Conservation without a reasoner:
# PREFIX oes: <https://www.in2use.com/one_earth_solutions/>
# SELECT DISTINCT ?solution WHERE {
#   ?solution a oes:Solution ;
#     oes:is_direct_subcategory_of+ oes:Nature_Conservation .
# }
# Expected: 24 solution categories.
#
# With inverse/subproperty/transitive reasoning enabled, this also works:
# SELECT DISTINCT ?solution WHERE {
#   ?solution a oes:Solution ;
#     oes:is_subcategory_of oes:Nature_Conservation .
# }
#
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oes: <https://www.in2use.com/one_earth_solutions/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

skos:altLabel a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:editorialNote a owl:AnnotationProperty .

skos:scopeNote a owl:AnnotationProperty .

