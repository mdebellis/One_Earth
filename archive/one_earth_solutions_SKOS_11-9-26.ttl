oes:has_direct_subcategory a owl:ObjectProperty ;
    rdfs:label "has direct subcategory"@en ;
    rdfs:domain oes:Solution_Category ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:range oes:Solution_Category ;
    rdfs:subPropertyOf oes:has_subcategory ;
    owl:inverseOf oes:is_direct_subcategory_of ;
    skos:definition "Relates a solution category to a category immediately below it in the published hierarchy."@en ;
    skos:scopeNote "This is a classification relationship. It does not assert physical containment, process composition, temporal ordering, or an OWL subclass relationship between the category individuals."@en .

oes:is_direct_subcategory_of a owl:ObjectProperty ;
    rdfs:label "is direct subcategory of"@en ;
    rdfs:domain oes:Solution_Category ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:range oes:Solution_Category ;
    rdfs:subPropertyOf oes:is_subcategory_of ;
    owl:inverseOf oes:has_direct_subcategory ;
    skos:definition "Relates a solution category to its immediate parent in the published hierarchy."@en ;
    skos:scopeNote "This is a classification relationship. It does not assert physical containment, process composition, temporal ordering, or an OWL subclass relationship between the category individuals."@en .

oes:has_subcategory a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has subcategory"@en ;
    rdfs:domain oes:Solution_Category ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:range oes:Solution_Category ;
    owl:inverseOf oes:is_subcategory_of ;
    skos:definition "Relates a solution category to a category below it through one or more hierarchy links."@en ;
    skos:scopeNote "This is a classification relationship. It does not assert physical containment, process composition, temporal ordering, or an OWL subclass relationship between the category individuals."@en .

oes:is_subcategory_of a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is subcategory of"@en ;
    rdfs:domain oes:Solution_Category ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:range oes:Solution_Category ;
    owl:inverseOf oes:has_subcategory ;
    skos:definition "Relates a solution category to a category above it through one or more hierarchy links."@en ;
    skos:scopeNote "This is a classification relationship. It does not assert physical containment, process composition, temporal ordering, or an OWL subclass relationship between the category individuals."@en .

oes:Category a owl:Class ;
