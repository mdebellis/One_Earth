<https://www.in2use.com/one_earth_what3words_examples> rdf:type owl:Ontology ;
                                                        owl:imports <https://www.in2use.com/one_earth_bioregions> ;
                                                        dcterms:created "2026-11-12"^^xsd:date ;
                                                        dcterms:description "A named module preserving the four published what3words examples and their existing One Earth entity IRIs. The examples were prepared on 2026-11-10; this ontology header was added on 2026-11-12 for modular imports."@en ;
                                                        dcterms:modified "2026-11-12"^^xsd:date ;
                                                        dcterms:rights "Existing source and what3words terms notices retain their scope. This module does not grant a license to third-party address data."@en ;
                                                        dcterms:title "one_earth_what3words_examples"@en ;
                                                        rdfs:comment "This module adds no address-coordinate conversions. The base ontology import supplies the reused classes and region definitions. All original example and property triples are unchanged."@en ;
                                                        rdfs:label "one earth what3words examples"@en ;
                                                        owl:versionInfo "0.1.0 — named module for existing examples"@en .

#################################################################
#    Data properties
#################################################################

###  https://www.in2use.com/one_earth_bioregions/what3words_address
oeb:what3words_address rdf:type owl:DatatypeProperty ;
                       rdfs:domain prov:Location ;
                       rdfs:range xsd:string ;
                       dcterms:source <https://what3words.com/about> ;
                       rdfs:isDefinedBy <https://www.in2use.com/one_earth_bioregions> ;
                       rdfs:label "what3words address"@en ;
                       rdfs:seeAlso <https://what3words.com/terms> ;
                       skos:definition "A three-word address assigned by what3words to a small geographical area, recorded in word.word.word format without the display prefix ///."@en ;
                       skos:scopeNote "The examples below use English addresses. This property does not assert a coordinate conversion, a navigation instruction, or an address for an entire bioregion."@en .


