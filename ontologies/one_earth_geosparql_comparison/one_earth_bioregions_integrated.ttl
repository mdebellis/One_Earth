<https://www.in2use.com/one_earth_bioregions/has_biome_type> rdf:type owl:ObjectProperty ; 
  owl:inverseOf <https://www.in2use.com/one_earth_bioregions/is_biome_type_of> ; 
  rdfs:domain <https://www.in2use.com/one_earth_bioregions/Geographical_Region> ; 
  rdfs:range <https://www.in2use.com/one_earth_bioregions/Biome_Type> ; 
  rdfs:isDefinedBy <https://www.in2use.com/one_earth_bioregions> ; 
  rdfs:label "has biome type"@en ; 
  skos:definition "Relates a geographical region to a biome category used to classify its ecological character."@en . 
<https://www.in2use.com/one_earth_bioregions/has_direct_region_part> rdf:type owl:ObjectProperty ; 
  rdfs:subPropertyOf <https://w3id.org/sulo/hasDirectPart>, <https://www.in2use.com/one_earth_bioregions/has_region_part> ; 
  owl:inverseOf <https://www.in2use.com/one_earth_bioregions/is_direct_region_part_of> ; 
  rdfs:domain <https://www.in2use.com/one_earth_bioregions/Geographical_Region> ; 
  rdfs:range <https://www.in2use.com/one_earth_bioregions/Geographical_Region> ; 
  rdfs:isDefinedBy <https://www.in2use.com/one_earth_bioregions> ; 
  rdfs:label "has direct region part"@en ; 
  skos:definition "Relates a geographical region to a wholly included geographical region at the next explicitly represented level of a hierarchy."@en . 
<https://www.in2use.com/one_earth_bioregions/has_ecoregion> rdf:type owl:ObjectProperty ; 
  owl:inverseOf <https://www.in2use.com/one_earth_bioregions/is_ecoregion_of> ; 
  rdfs:domain <https://www.in2use.com/one_earth_bioregions/Bioregion> ; 
  rdfs:range <https://www.in2use.com/one_earth_bioregions/Ecoregion> ; 
  rdfs:isDefinedBy <https://www.in2use.com/one_earth_bioregions> ; 
  rdfs:label "has ecoregion"@en ; 
  skos:definition "Relates a bioregion to an ecoregion listed as a component by the source; all or part of that ecoregion may occur in the bioregion."@en ; 
  skos:scopeNote "This association does not by itself assert whole-area containment. One Earth permits mangrove ecoregions to be split across bioregions. It is not a subproperty of has_region_part."@en . 
<https://www.in2use.com/one_earth_bioregions/has_region_part> rdf:type owl:ObjectProperty ; 
  rdfs:subPropertyOf <https://w3id.org/sulo/hasPart> ; 
  owl:inverseOf <https://www.in2use.com/one_earth_bioregions/is_region_part_of> ; 
  rdf:type owl:TransitiveProperty ; 
  rdfs:domain <https://www.in2use.com/one_earth_bioregions/Geographical_Region> ; 
  rdfs:range <https://www.in2use.com/one_earth_bioregions/Geographical_Region> ; 
  rdfs:isDefinedBy <https://www.in2use.com/one_earth_bioregions> ; 
  rdfs:label "has region part"@en ; 
  skos:definition "Relates a geographical region to another geographical region wholly included in it, directly or through intermediate regions."@en . 
<https://www.in2use.com/one_earth_bioregions/is_biome_type_of> rdf:type owl:ObjectProperty ; 
  rdfs:domain <https://www.in2use.com/one_earth_bioregions/Biome_Type> ; 
  rdfs:range <https://www.in2use.com/one_earth_bioregions/Geographical_Region> ; 
  rdfs:isDefinedBy <https://www.in2use.com/one_earth_bioregions> ; 
  rdfs:label "is biome type of"@en ; 
  skos:definition "Relates a biome category to a geographical region classified using that category."@en . 
<https://www.in2use.com/one_earth_bioregions/is_direct_region_part_of> rdf:type owl:ObjectProperty ; 
  rdfs:subPropertyOf <https://w3id.org/sulo/isDirectPartOf>, <https://www.in2use.com/one_earth_bioregions/is_region_part_of> ; 
  rdfs:domain <https://www.in2use.com/one_earth_bioregions/Geographical_Region> ; 
  rdfs:range <https://www.in2use.com/one_earth_bioregions/Geographical_Region> ; 
  rdfs:isDefinedBy <https://www.in2use.com/one_earth_bioregions> ; 
  rdfs:label "is direct region part of"@en ; 
  skos:definition "Relates a geographical region to its immediate containing region in the explicitly represented hierarchy."@en . 
<https://www.in2use.com/one_earth_bioregions/is_ecoregion_of> rdf:type owl:ObjectProperty ; 
  rdfs:domain <https://www.in2use.com/one_earth_bioregions/Ecoregion> ; 
  rdfs:range <https://www.in2use.com/one_earth_bioregions/Bioregion> ; 
  rdfs:isDefinedBy <https://www.in2use.com/one_earth_bioregions> ; 
  rdfs:label "is ecoregion of"@en ; 
  skos:definition "Relates an ecoregion to a bioregion for which the source lists that ecoregion as a component, in whole or in part."@en . 
<https://www.in2use.com/one_earth_bioregions/is_region_part_of> rdf:type owl:ObjectProperty ; 
  rdfs:subPropertyOf <https://w3id.org/sulo/isPartOf> ; 
  rdf:type owl:TransitiveProperty ; 
  rdfs:domain <https://www.in2use.com/one_earth_bioregions/Geographical_Region> ; 
  rdfs:range <https://www.in2use.com/one_earth_bioregions/Geographical_Region> ; 
  rdfs:isDefinedBy <https://www.in2use.com/one_earth_bioregions> ; 
  rdfs:label "is region part of"@en ; 
  skos:definition "Relates a geographical region to a region in which it is wholly included, directly or through intermediate regions."@en . 
