<https://www.in2use.com/one_earth_geosparql> rdf:type owl:Ontology ; 
  rdfs:label "one_earth_geosparql"@en ; 
  dcterms:conformsTo <http://www.opengis.net/doc/IS/geosparql/1.1> ; 
  dcterms:created "2026-11-10"^^xsd:date ; 
  dcterms:creator <https://orcid.org/0000-0002-8824-9577> ; 
  dcterms:description "Optional GeoSPARQL schema alignment and One Earth 2023 bioregion boundary data. Load with one_earth_bioregions using the combined wrapper, or load both data files into the same AllegroGraph repository."@en ; 
  dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ; 
  dcterms:rights "The CC BY-NC 4.0 declaration applies to this One Earth-derived module. Reused GeoSPARQL terms retain their standard identifiers and their OGC provenance; the declaration does not relicense external vocabularies."@en ; 
  dcterms:source <https://assets.takeshape.io/237b7856-239f-4c62-9f9e-0b9ce73fa864/dev/aeb6d1cd-6cc7-4849-b0fd-70eeed16a417/one_earth-bioregions-2023.geojson.zip>, <https://github.com/mdebellis/One_Earth/blob/196cfe58775f5b6475886f8a1b28ec62ad33858a/ontologies/one_earth_bioregions.ttl> ; 
  dcterms:title "one_earth_geosparql"@en ; 
  rdfs:comment "This module includes selected standard GeoSPARQL declarations and axioms needed by its data, rather than a full copy of the OGC ontology. Standard IRIs are retained. It does not assert spatial calculations or require AllegroGraph-specific vocabulary. The supplied shapes cover bioregions only; no realm, subrealm, ecoregion, political-region, or biome-category geometries are asserted."@en ; 
  owl:versionInfo "0.1.0 — first GeoSPARQL comparison release"@en ; 
  skos:scopeNote "Coordinates are copied from the One Earth 2023 GeoJSON without simplification, rounding, or geometry repair. All 185 geometries passed GEOS planar validity checks. This does not establish geodetic accuracy or AllegroGraph behavior at global edge cases. Geometry calculations require a GeoSPARQL-capable engine; OWL reasoners do not interpret the polygon coordinates."@en . 
<http://www.opengis.net/ont/geosparql#Feature> rdf:type owl:Class ; 
  rdfs:label "Feature"@en ; 
  rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql> ; 
  rdfs:subClassOf <http://www.opengis.net/ont/geosparql#SpatialObject> ; 
  owl:disjointWith <http://www.opengis.net/ont/geosparql#Geometry> . 
<http://www.opengis.net/ont/geosparql#Geometry> rdf:type owl:Class ; 
  rdfs:label "Geometry"@en ; 
  rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql> ; 
  rdfs:subClassOf <http://www.opengis.net/ont/geosparql#SpatialObject> . 
<https://www.in2use.com/one_earth_bioregions/what3words_address> rdf:type owl:DatatypeProperty ; 
  rdfs:label "what3words address"@en ; 
  rdfs:domain <http://www.w3.org/ns/prov#Location> ; 
  rdfs:range xsd:string ; 
  skos:definition "A three-word address assigned by what3words to a small geographical area, recorded in word.word.word format without the display prefix ///."@en ; 
  skos:scopeNote "The examples below use English addresses. This property does not assert a coordinate conversion, a navigation instruction, or an address for an entire bioregion."@en ; 
  dcterms:source <https://what3words.com/about> ; 
  rdfs:seeAlso <https://what3words.com/terms> ; 
  rdfs:isDefinedBy <https://www.in2use.com/one_earth_bioregions> . 
