# Run each SELECT separately in Gruff, repeating these PREFIX declarations.
# These examples work on asserted data: they do not require materialization.
PREFIX oes: <https://www.in2use.com/one_earth_solutions/>
PREFIX oeb: <https://www.in2use.com/one_earth_bioregions/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

# 1. One Earth's solution pathways and their parent groupings (76 rows).
SELECT DISTINCT ?solution ?sourceTitle ?subpillarTitle ?pillarTitle
WHERE {
  ?solution oes:framework_level oes:Solution_Level ;
            dcterms:title ?sourceTitle ;
            rdfs:subClassOf ?subpillar .
  ?subpillar oes:framework_level oes:Subpillar_Level ;
             dcterms:title ?subpillarTitle ;
             rdfs:subClassOf ?pillar .
  ?pillar oes:framework_level oes:Pillar_Level ;
          dcterms:title ?pillarTitle .
}
ORDER BY ?pillarTitle ?subpillarTitle ?sourceTitle

# 2. The two example activities with a region as an explicitly stated target.
# Location and target are shown separately; region hierarchy is reused.
SELECT DISTINCT ?activityLabel ?locationLabel ?targetLabel ?realmLabel
WHERE {
  ?activity oes:is_illustrative_example true ;
            oes:has_location ?location ;
            oes:has_target ?target ;
            rdfs:label ?activityLabel .
  ?location rdfs:label ?locationLabel .
  ?target a oeb:Bioregion ; rdfs:label ?targetLabel ;
          oeb:is_direct_region_part_of/oeb:is_direct_region_part_of ?realm .
  ?realm a oeb:Realm ; rdfs:label ?realmLabel .
}
ORDER BY ?activityLabel

# 3. Species targeted by the fictional wetland restoration effort (Coho Salmon).
SELECT DISTINCT ?species ?name ?scientificName
WHERE {
  oes:Example_Wetland_Restoration oes:has_target ?species .
  ?species a oes:Species ; rdfs:label ?name ;
           oes:scientific_name ?scientificName .
}

# 4. Component activities, including nested components (two rows).
SELECT DISTINCT ?component ?label
WHERE {
  oes:Example_Wetland_Restoration oes:has_subprocess+ ?component .
  ?component rdfs:label ?label .
}

# 5. All example nature-conservation activities (three rows).
# rdf:type/rdfs:subClassOf* works even before materializing class memberships.
SELECT DISTINCT ?activity ?label
WHERE {
  ?activity oes:is_illustrative_example true ; rdfs:label ?label ;
            a/rdfs:subClassOf* oes:Nature_Conservation_Activity .
}
