@prefix : <https://www.in2use.com/one_earth_solutions#> .
@prefix oeb: <https://www.in2use.com/one_earth_bioregions/> .
@prefix oes: <https://www.in2use.com/one_earth_solutions/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://www.in2use.com/one_earth_solutions> .

<https://www.in2use.com/one_earth_solutions> rdf:type owl:Ontology ;
                                              owl:imports <https://www.in2use.com/one_earth_bioregions> ,
                                                          <https://www.in2use.com/one_earth_geosparql> ,
                                                          <https://www.in2use.com/one_earth_what3words_examples> ;
                                              dcterms:created "2026-11-11"^^xsd:date ;
                                              dcterms:creator "Michael DeBellis"@en ;
                                              dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
                                              dcterms:modified "2026-11-12"^^xsd:date ;
                                              dcterms:rights "Names, source hierarchy, and links are attributed to One Earth. Process semantics and concise draft descriptions were prepared for Common Action. This is not an official One Earth ontology. The license follows the existing project repository."@en ;
                                              dcterms:source <https://www.oneearth.org/categories/> ,
                                                             <https://www.oneearth.org/solutions/> ;
                                              dcterms:title "one_earth_solutions"@en ;
                                              rdfs:comment "Directly imports the Bioregions ontology, which embeds Big Bro, SULO, and PROV, together with the GeoSPARQL and what3words modules. No separate integration wrapper or full process-model ontology is required."@en ,
                                                           "The framework hierarchy denotes kinds of activity, not subprocess composition. Classes may overlap. A target denotes intended focus and does not assert successful impact, physical participation, location, or modification of an entire region. Six fictional demonstration individuals are flagged with is_illustrative_example."@en ,
                                                           "This draft interprets the 3 pillars, 12 subpillars, and 76 solution pathways as OWL classes of activities. The process interpretation and concise definitions are Common Action modeling choices, not claims that One Earth publishes an OWL process ontology. Original headings and source URLs are retained."@en ;
                                              rdfs:label "one earth solutions"@en ;
                                              owl:versionInfo "0.2.2 - direct imports of Bioregions, GeoSPARQL, and what3words"@en ;
                                              skos:definition "A Common Action ontology of climate solution activities, based on One Earth’s framework and integrated with the One Earth Bioregions ontology and its Big Bro foundation."@en ;
                                              skos:editorialNote "Source hierarchy reviewed on 2026-11-11. The Renewable Power category page additionally lists Advanced Nuclear, absent from the main framework page. The 76 pathways follow the main framework pending source reconciliation."@en ;
                                              skos:historyNote "Version 0.2 replaces the standalone category-individual draft (0.1). Load this version instead of merging it with 0.1; some former category IRIs now identify classes and others have action-oriented replacements. No class/individual punning is intended."@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
dcterms:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dcterms:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/rights
dcterms:rights rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
dcterms:source rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#editorialNote
skos:editorialNote rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#historyNote
skos:historyNote rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#scopeNote
skos:scopeNote rdf:type owl:AnnotationProperty .


###  https://www.in2use.com/one_earth_solutions/framework_level
oes:framework_level rdf:type owl:AnnotationProperty ;
                    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                    rdfs:label "framework level"@en ;
                    skos:definition "Records the published framework level of an activity class using a Framework Level individual; this is classification metadata, not an object-property assertion on a class."@en .


#################################################################
#    Object Properties
#################################################################

###  https://www.in2use.com/one_earth_solutions/has_intersectional_theme
oes:has_intersectional_theme rdf:type owl:ObjectProperty ;
                             owl:inverseOf oes:is_intersectional_theme_of ;
                             rdfs:domain oes:Climate_Solution ;
                             rdfs:range oes:Intersectional_Theme ;
                             rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                             rdfs:label "has intersectional theme"@en ;
                             skos:definition "Relates a solution activity to a cross-cutting concern explicitly associated with that activity."@en .


###  https://www.in2use.com/one_earth_solutions/has_lever_of_change
oes:has_lever_of_change rdf:type owl:ObjectProperty ;
                        owl:inverseOf oes:is_lever_of_change_of ;
                        rdfs:domain oes:Climate_Solution ;
                        rdfs:range oes:Lever_Of_Change ;
                        rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                        rdfs:label "has lever of change"@en ;
                        skos:definition "Relates a solution activity to an enabling mechanism or strategy it uses."@en .


###  https://www.in2use.com/one_earth_solutions/has_location
oes:has_location rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prov:atLocation ;
                 owl:inverseOf oes:is_location_of ;
                 rdfs:range oeb:Geographical_Region ;
                 rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                 rdfs:label "has location"@en ;
                 skos:definition "Relates an activity, entity, or agent to a geographical region where it occurs or is situated. Location does not imply that the whole region is affected."@en .


###  https://www.in2use.com/one_earth_solutions/has_responsible_agent
oes:has_responsible_agent rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf prov:wasAssociatedWith ;
                          owl:inverseOf oes:is_responsible_agent_of ;
                          rdfs:domain oes:Climate_Solution ;
                          rdfs:range prov:Agent ;
                          rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                          rdfs:label "has responsible agent"@en ;
                          skos:definition "Relates a solution activity to an agent assigned responsibility for carrying it out."@en .


###  https://www.in2use.com/one_earth_solutions/has_subprocess
oes:has_subprocess rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf sulo:hasPart ;
                   owl:inverseOf oes:is_subprocess_of ;
                   rdf:type owl:TransitiveProperty ;
                   rdfs:domain sulo:Process ;
                   rdfs:range sulo:Process ;
                   rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                   rdfs:label "has subprocess"@en ;
                   skos:definition "Relates a process to a component process, directly or through other component processes. It does not express a subclass relation, sequence, dependency, or spatial containment."@en .


###  https://www.in2use.com/one_earth_solutions/has_target
oes:has_target rdf:type owl:ObjectProperty ;
               owl:inverseOf oes:is_target_of ;
               rdfs:domain oes:Climate_Solution ;
               rdfs:range sulo:Object ;
               rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
               rdfs:label "has target"@en ;
               skos:definition "Relates an activity to an intended focus of its effort, such as a region, ecosystem, or species taxon. It does not imply that the target participates, that the activity occurs there, or that the intended outcome has been achieved."@en .


###  https://www.in2use.com/one_earth_solutions/is_intersectional_theme_of
oes:is_intersectional_theme_of rdf:type owl:ObjectProperty ;
                               rdfs:domain oes:Intersectional_Theme ;
                               rdfs:range oes:Climate_Solution ;
                               rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                               rdfs:label "is intersectional theme of"@en ;
                               skos:definition "The inverse of has intersectional theme."@en .


###  https://www.in2use.com/one_earth_solutions/is_lever_of_change_of
oes:is_lever_of_change_of rdf:type owl:ObjectProperty ;
                          rdfs:domain oes:Lever_Of_Change ;
                          rdfs:range oes:Climate_Solution ;
                          rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                          rdfs:label "is lever of change of"@en ;
                          skos:definition "The inverse of has lever of change."@en .


###  https://www.in2use.com/one_earth_solutions/is_location_of
oes:is_location_of rdf:type owl:ObjectProperty ;
                   rdfs:domain oeb:Geographical_Region ;
                   rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                   rdfs:label "is location of"@en ;
                   skos:definition "The inverse of has location."@en .


###  https://www.in2use.com/one_earth_solutions/is_responsible_agent_of
oes:is_responsible_agent_of rdf:type owl:ObjectProperty ;
                            rdfs:domain prov:Agent ;
                            rdfs:range oes:Climate_Solution ;
                            rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                            rdfs:label "is responsible agent of"@en ;
                            skos:definition "The inverse of has responsible agent."@en .


###  https://www.in2use.com/one_earth_solutions/is_subprocess_of
oes:is_subprocess_of rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf sulo:isPartOf ;
                     rdf:type owl:TransitiveProperty ;
                     rdfs:domain sulo:Process ;
                     rdfs:range sulo:Process ;
                     rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                     rdfs:label "is subprocess of"@en ;
                     skos:definition "The inverse of has subprocess."@en .


###  https://www.in2use.com/one_earth_solutions/is_target_of
oes:is_target_of rdf:type owl:ObjectProperty ;
                 rdfs:domain sulo:Object ;
                 rdfs:range oes:Climate_Solution ;
                 rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                 rdfs:label "is target of"@en ;
                 skos:definition "The inverse of has target."@en .


#################################################################
#    Data properties
#################################################################

###  https://www.in2use.com/one_earth_solutions/is_illustrative_example
oes:is_illustrative_example rdf:type owl:DatatypeProperty ;
                            rdfs:range xsd:boolean ;
                            rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                            rdfs:label "is illustrative example"@en ;
                            skos:definition "True marks fictional demonstration data; absence of this flag does not establish that an individual is verified."@en .


###  https://www.in2use.com/one_earth_solutions/scientific_name
oes:scientific_name rdf:type owl:DatatypeProperty ;
                    rdfs:domain oes:Species ;
                    rdfs:range xsd:string ;
                    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                    rdfs:label "scientific name"@en ;
                    skos:definition "The scientific name of a species taxon."@en .


#################################################################
#    Classes
#################################################################

###  https://www.in2use.com/one_earth_solutions/Agritecture_Practice
oes:Agritecture_Practice rdf:type owl:Class ;
                         rdfs:subClassOf oes:Regenerative_Cropland_Management ;
                         dcterms:source <https://www.oneearth.org/category/agritecture/> ,
                                        <https://www.oneearth.org/solutions/> ;
                         dcterms:title "Agritecture"@en ;
                         rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                         rdfs:label "Agritecture Practice"@en ;
                         rdfs:seeAlso <https://www.oneearth.org/category/agritecture/> ;
                         skos:definition "An activity involving integrating food production with buildings and designed growing environments."@en ;
                         oes:framework_level oes:Solution_Level .


###  https://www.in2use.com/one_earth_solutions/Agroforestry_Practice
oes:Agroforestry_Practice rdf:type owl:Class ;
                          rdfs:subClassOf oes:Regenerative_Cropland_Management ;
                          dcterms:source <https://www.oneearth.org/category/agroforestry/> ,
                                         <https://www.oneearth.org/solutions/> ;
                          dcterms:title "Agroforestry"@en ;
                          rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                          rdfs:label "Agroforestry Practice"@en ;
                          rdfs:seeAlso <https://www.oneearth.org/category/agroforestry/> ;
                          skos:definition "An activity involving growing trees together with agricultural crops or livestock."@en ;
                          oes:framework_level oes:Solution_Level .


###  https://www.in2use.com/one_earth_solutions/Bioregional_Sourcing
oes:Bioregional_Sourcing rdf:type owl:Class ;
                         rdfs:subClassOf oes:Food_Waste_Reduction ;
                         dcterms:source <https://www.oneearth.org/category/local-sourcing/> ,
                                        <https://www.oneearth.org/solutions/> ;
                         dcterms:title "Bioregional Sourcing"@en ;
                         rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                         rdfs:label "Bioregional Sourcing"@en ;
                         rdfs:seeAlso <https://www.oneearth.org/category/local-sourcing/> ;
                         skos:definition "An activity sourcing food from the surrounding bioregion with the intention of reducing food losses or waste through shorter, locally coordinated supply chains."@en ;
                         skos:scopeNote "This class denotes the activity when intended to contribute to its parent objective in this Common Action interpretation. The source heading is broader: its placement in One Earth’s framework alone does not establish that every real-world instance advances that objective. No successful outcome is implied."@en ;
                         oes:framework_level oes:Solution_Level .


###  https://www.in2use.com/one_earth_solutions/Buffer_And_Greenway_Management
oes:Buffer_And_Greenway_Management rdf:type owl:Class ;
                                   rdfs:subClassOf oes:Wildlife_Connectivity_Improvement ;
                                   dcterms:source <https://www.oneearth.org/category/buffers/> ,
                                                  <https://www.oneearth.org/solutions/> ;
                                   dcterms:title "Buffers & Greenways"@en ;
                                   rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                                   rdfs:label "Buffer And Greenway Management"@en ;
                                   rdfs:seeAlso <https://www.oneearth.org/category/buffers/> ;
                                   skos:definition "An activity involving maintaining vegetated areas that protect habitats and connect landscapes."@en ;
                                   oes:framework_level oes:Solution_Level .


###  https://www.in2use.com/one_earth_solutions/Built_Environment_Efficiency_Improvement
oes:Built_Environment_Efficiency_Improvement rdf:type owl:Class ;
                                             rdfs:subClassOf oes:Energy_Efficiency_Improvement ;
                                             dcterms:source <https://www.oneearth.org/category/buildings/> ,
                                                            <https://www.oneearth.org/solutions/> ;
                                             dcterms:title "Built Environment"@en ;
                                             rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                                             rdfs:label "Built Environment Efficiency Improvement"@en ;
                                             rdfs:seeAlso <https://www.oneearth.org/category/buildings/> ;
                                             skos:definition "An activity involving reducing energy and material demands of buildings and constructed infrastructure."@en ;
                                             oes:framework_level oes:Solution_Level .


###  https://www.in2use.com/one_earth_solutions/Circular_Fibershed_Management
oes:Circular_Fibershed_Management rdf:type owl:Class ;
                                  rdfs:subClassOf oes:Regenerative_Agriculture_Activity ;
                                  dcterms:source <https://www.oneearth.org/category/fabric/> ,
                                                 <https://www.oneearth.org/solutions/> ;
                                  dcterms:title "Circular Fibersheds"@en ;
                                  rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                                  rdfs:label "Circular Fibershed Management"@en ;
                                  rdfs:seeAlso <https://www.oneearth.org/category/fabric/> ;
                                  skos:definition "An activity involving producing, using, and recovering fibers within regenerative material cycles."@en ;
                                  oes:framework_level oes:Subpillar_Level .


###  https://www.in2use.com/one_earth_solutions/Climate_Fundraising
oes:Climate_Fundraising rdf:type owl:Class ;
                        rdfs:subClassOf oes:Climate_Solution ;
                        rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                        rdfs:label "Climate Fundraising"@en ;
                        skos:definition "An activity seeking financial support for climate or ecological action; a supporting Common Action class outside the 76 published pathways."@en .


###  https://www.in2use.com/one_earth_solutions/Climate_Refugia_Protection
oes:Climate_Refugia_Protection rdf:type owl:Class ;
                               rdfs:subClassOf oes:Land_Conservation ;
                               dcterms:source <https://www.oneearth.org/category/other-refugia/> ,
                                              <https://www.oneearth.org/solutions/> ;
                               dcterms:title "Climate Refugia"@en ;
                               rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                               rdfs:label "Climate Refugia Protection"@en ;
                               rdfs:seeAlso <https://www.oneearth.org/category/other-refugia/> ;
                               skos:definition "An activity involving protecting unprotected lands important for carbon storage and climate stabilization in One Earth’s framework."@en ;
                               skos:scopeNote "Follows One Earth’s use of this heading for carbon-rich climate-stabilization lands, not every scientific meaning of climate refugium."@en ;
                               oes:framework_level oes:Solution_Level .


###  https://www.in2use.com/one_earth_solutions/Climate_Solution
oes:Climate_Solution rdf:type owl:Class ;
                     rdfs:subClassOf prov:Activity ;
                     rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                     rdfs:label "Climate Solution"@en ;
                     skos:definition "An activity intended to contribute to climate mitigation, ecological conservation, or regenerative food and fiber systems; intended purpose does not assert successful results."@en ;
                     skos:scopeNote "Individuals are particular activities or efforts. The framework classes are activity types. Plans, technology artifacts, geographical areas, species taxa, and measured outcomes are not themselves solution activities."@en .


###  https://www.in2use.com/one_earth_solutions/Coastal_Restoration
oes:Coastal_Restoration rdf:type owl:Class ;
                        rdfs:subClassOf oes:Ecosystem_Restoration ;
                        dcterms:source <https://www.oneearth.org/category/coral/> ,
                                       <https://www.oneearth.org/solutions/> ;
                        dcterms:title "Coastal Restoration"@en ;
                        rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                        rdfs:label "Coastal Restoration"@en ;
                        rdfs:seeAlso <https://www.oneearth.org/category/coral/> ;
                        skos:definition "An activity involving restoring degraded coastal ecosystems, including damaged coral systems."@en ;
                        oes:framework_level oes:Solution_Level .


###  https://www.in2use.com/one_earth_solutions/Composting
oes:Composting rdf:type owl:Class ;
               rdfs:subClassOf oes:Food_Waste_Reduction ;
               dcterms:source <https://www.oneearth.org/category/composting/> ,
                              <https://www.oneearth.org/solutions/> ;
               dcterms:title "Composting"@en ;
               rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
               rdfs:label "Composting"@en ;
               rdfs:seeAlso <https://www.oneearth.org/category/composting/> ;
               skos:definition "An activity involving biologically converting organic residues into useful soil amendments."@en ;
               oes:framework_level oes:Solution_Level .


###  https://www.in2use.com/one_earth_solutions/Crop_Optimization
oes:Crop_Optimization rdf:type owl:Class ;
                      rdfs:subClassOf oes:Regenerative_Cropland_Management ;
                      dcterms:source <https://www.oneearth.org/category/crop-optimization/> ,
                                     <https://www.oneearth.org/solutions/> ;
                      dcterms:title "Crop Optimization"@en ;
                      rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                      rdfs:label "Crop Optimization"@en ;
                      rdfs:seeAlso <https://www.oneearth.org/category/crop-optimization/> ;
                      skos:definition "An activity involving selecting crop production patterns suited to local conditions and resource availability."@en ;
                      oes:framework_level oes:Solution_Level .


###  https://www.in2use.com/one_earth_solutions/Cropland_Restoration
oes:Cropland_Restoration rdf:type owl:Class ;
                         rdfs:subClassOf oes:Regenerative_Cropland_Management ;
                         dcterms:source <https://www.oneearth.org/category/cropland-restoration/> ,
                                        <https://www.oneearth.org/solutions/> ;
                         dcterms:title "Cropland Restoration"@en ;
                         rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                         rdfs:label "Cropland Restoration"@en ;
                         rdfs:seeAlso <https://www.oneearth.org/category/cropland-restoration/> ;
                         skos:definition "An activity involving recovering the productive and ecological functions of degraded cropland."@en ;
                         oes:framework_level oes:Solution_Level .


###  https://www.in2use.com/one_earth_solutions/Dryland_Irrigation
oes:Dryland_Irrigation rdf:type owl:Class ;
                       rdfs:subClassOf oes:Regenerative_Cropland_Management ;
                       dcterms:source <https://www.oneearth.org/category/dryland-irrigation/> ,
                                      <https://www.oneearth.org/solutions/> ;
                       dcterms:title "Dryland Irrigation"@en ;
                       rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                       rdfs:label "Dryland Irrigation"@en ;
                       rdfs:seeAlso <https://www.oneearth.org/category/dryland-irrigation/> ;
                       skos:definition "An activity involving irrigating suitable rainfed cropland without exhausting sustainable water resources."@en ;
                       oes:framework_level oes:Solution_Level .


###  https://www.in2use.com/one_earth_solutions/Ecosystem
oes:Ecosystem rdf:type owl:Class ;
              rdfs:subClassOf prov:Entity ,
                              sulo:SpatialObject ;
              rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
              rdfs:label "Ecosystem"@en ;
              skos:definition "A particular ecological system comprising organisms, their physical environment, and their interactions."@en .


###  https://www.in2use.com/one_earth_solutions/Ecosystem_Restoration
oes:Ecosystem_Restoration rdf:type owl:Class ;
                          rdfs:subClassOf oes:Nature_Conservation_Activity ;
                          dcterms:source <https://www.oneearth.org/category/restoration/> ,
                                         <https://www.oneearth.org/solutions/> ;
                          dcterms:title "Ecosystem Restoration"@en ;
                          rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                          rdfs:label "Ecosystem Restoration"@en ;
                          rdfs:seeAlso <https://www.oneearth.org/category/restoration/> ;
                          skos:definition "An activity intended to advance ecological restoration or recovery, including direct restorative work and forest management that supports recovery."@en ;
                          oes:framework_level oes:Subpillar_Level .


###  https://www.in2use.com/one_earth_solutions/Electric_Transport_Operation
oes:Electric_Transport_Operation rdf:type owl:Class ;
                                 rdfs:subClassOf oes:Renewable_Transport_Activity ;
                                 dcterms:source <https://www.oneearth.org/category/electric-transport/> ,
                                                <https://www.oneearth.org/solutions/> ;
                                 dcterms:title "Electric Transport"@en ;
                                 rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
                                 rdfs:label "Electric Transport Operation"@en ;
                                 rdfs:seeAlso <https://www.oneearth.org/category/electric-transport/> ;
                                 skos:definition "An activity involving operating transport systems using renewable electricity."@en ;
                                 oes:framework_level oes:Solution_Level .


###  https://www.in2use.com/one_earth_solutions/Energy_Efficiency_Improvement
oes:Energy_Efficiency_Improvement rdf:type owl:Class ;
                                  rdfs:subClassOf oes:Energy_Transition_Activity ;
                                  dcterms:source <https://www.oneearth.org/category/efficiency/> ,
                                                 <https://www.oneearth.org/solutions/> ;
                                  dcterms:title "Energy Efficiency"@en ;
                                  rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
