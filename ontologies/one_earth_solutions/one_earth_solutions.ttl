        <https://www.oneearth.org/solutions/> ;
    dcterms:title "Ocean Conservation"@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:seeAlso <https://www.oneearth.org/category/oceans/> ;
    rdfs:subClassOf oes:Nature_Conservation_Activity ;
    skos:definition "An activity involving conserving marine ecosystems and maintaining sustainable uses of ocean resources."@en ;
    oes:framework_level oes:Subpillar_Level .

oes:Regenerative_Agriculture_Activity a owl:Class ;
    rdfs:label "Regenerative Agriculture Activity"@en ;
    dcterms:source <https://www.oneearth.org/category/regenerative-agriculture/>,
        <https://www.oneearth.org/solutions/> ;
    dcterms:title "Regenerative Agriculture"@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:seeAlso <https://www.oneearth.org/category/regenerative-agriculture/> ;
    rdfs:subClassOf oes:Climate_Solution ;
    skos:definition "An activity advancing more regenerative food or fiber systems through one or more production, consumption, or resource-recovery pathways."@en ;
    oes:framework_level oes:Pillar_Level .

oes:Renewable_Transport_Activity a owl:Class ;
    rdfs:label "Renewable Transport Activity"@en ;
    dcterms:source <https://www.oneearth.org/category/renewable-transport/>,
        <https://www.oneearth.org/solutions/> ;
    dcterms:title "Renewable Transport"@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:seeAlso <https://www.oneearth.org/category/renewable-transport/> ;
    rdfs:subClassOf oes:Energy_Transition_Activity ;
    skos:definition "An activity involving powering transportation with renewable electricity or sustainably produced fuels."@en ;
    oes:framework_level oes:Subpillar_Level .

oes:Wildlife_Connectivity_Improvement a owl:Class ;
    rdfs:label "Wildlife Connectivity Improvement"@en ;
    dcterms:source <https://www.oneearth.org/category/connectivity/>,
        <https://www.oneearth.org/solutions/> ;
    dcterms:title "Wildlife Connectivity"@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:seeAlso <https://www.oneearth.org/category/connectivity/> ;
    rdfs:subClassOf oes:Nature_Conservation_Activity ;
    skos:definition "An activity involving maintaining connected habitats that support wildlife movement and migration."@en ;
    oes:framework_level oes:Subpillar_Level .

oes:Rangeland_Sustainability_Activity a owl:Class ;
    rdfs:label "Rangeland Sustainability Activity"@en ;
    dcterms:source <https://www.oneearth.org/category/rangelands/>,
        <https://www.oneearth.org/solutions/> ;
    dcterms:title "Sustainable Rangelands"@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:seeAlso <https://www.oneearth.org/category/rangelands/> ;
    rdfs:subClassOf oes:Regenerative_Agriculture_Activity ;
    skos:definition "An activity intended to advance rangeland sustainability through improved grazing systems, livestock feeding, or reductions in demand for livestock production."@en ;
    oes:framework_level oes:Subpillar_Level .

oes:Food_Waste_Reduction a owl:Class ;
    rdfs:label "Food Waste Reduction"@en ;
    dcterms:source <https://www.oneearth.org/category/food/>,
        <https://www.oneearth.org/solutions/> ;
    dcterms:title "Food Waste Reduction"@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:seeAlso <https://www.oneearth.org/category/food/> ;
    rdfs:subClassOf oes:Regenerative_Agriculture_Activity ;
    skos:definition "An activity intended to prevent food loss or waste, or to recover useful value from food-system resources, including supporting sourcing, growing, and consumption practices."@en ;
    oes:framework_level oes:Subpillar_Level .

oes:Renewable_Heat_Provision a owl:Class ;
    rdfs:label "Renewable Heat Provision"@en ;
    dcterms:source <https://www.oneearth.org/category/heating/>,
        <https://www.oneearth.org/solutions/> ;
    dcterms:title "Renewable Heat"@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:seeAlso <https://www.oneearth.org/category/heating/> ;
    rdfs:subClassOf oes:Energy_Transition_Activity ;
    skos:definition "An activity involving supplying useful heat through renewable sources and related heating technologies."@en ;
    oes:framework_level oes:Subpillar_Level .

oes:Land_Conservation a owl:Class ;
    rdfs:label "Land Conservation"@en ;
    dcterms:source <https://www.oneearth.org/category/wildlands/>,
        <https://www.oneearth.org/solutions/> ;
    dcterms:title "Land Conservation"@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:seeAlso <https://www.oneearth.org/category/wildlands/> ;
    rdfs:subClassOf oes:Nature_Conservation_Activity ;
    skos:definition "An activity involving conserving terrestrial ecosystems, biodiversity, and the communities that steward them."@en ;
    oes:framework_level oes:Subpillar_Level .

oes:Intersectional_Theme a owl:Class ;
    rdfs:label "Intersectional Theme"@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A named cross-cutting concern used when designing or assessing climate solution activities."@en .

oes:Lever_Of_Change a owl:Class ;
    rdfs:label "Lever Of Change"@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A named category of enabling mechanism or strategy used by a climate solution activity."@en .

oes:Renewable_Power_Production a owl:Class ;
    rdfs:label "Renewable Power Production"@en ;
    dcterms:source <https://www.oneearth.org/category/electricity/>,
        <https://www.oneearth.org/solutions/> ;
    dcterms:title "Renewable Power"@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:seeAlso <https://www.oneearth.org/category/electricity/> ;
    rdfs:subClassOf oes:Energy_Transition_Activity ;
    skos:definition "An activity involving supplying electricity through the renewable energy pathways grouped here by One Earth."@en ;
    oes:framework_level oes:Subpillar_Level .

oes:Ecosystem_Restoration a owl:Class ;
    rdfs:label "Ecosystem Restoration"@en ;
    dcterms:source <https://www.oneearth.org/category/restoration/>,
        <https://www.oneearth.org/solutions/> ;
    dcterms:title "Ecosystem Restoration"@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:seeAlso <https://www.oneearth.org/category/restoration/> ;
    rdfs:subClassOf oes:Nature_Conservation_Activity ;
    skos:definition "An activity intended to advance ecological restoration or recovery, including direct restorative work and forest management that supports recovery."@en ;
    oes:framework_level oes:Subpillar_Level .

oes:Climate_Solution a owl:Class ;
    rdfs:label "Climate Solution"@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "An activity intended to contribute to climate mitigation, ecological conservation, or regenerative food and fiber systems; intended purpose does not assert successful results."@en ;
    skos:scopeNote "Individuals are particular activities or efforts. The framework classes are activity types. Plans, technology artifacts, geographical areas, species taxa, and measured outcomes are not themselves solution activities."@en .

oes:Subpillar_Level a owl:NamedIndividual,
        oes:Framework_Level ;
    rdfs:label "Subpillar Level"@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    skos:definition "An intermediate grouping in the One Earth solutions framework."@en .

oes:Regenerative_Cropland_Management a owl:Class ;
    rdfs:label "Regenerative Cropland Management"@en ;
    dcterms:source <https://www.oneearth.org/category/croplands/>,
        <https://www.oneearth.org/solutions/> ;
    dcterms:title "Regenerative Croplands"@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    rdfs:seeAlso <https://www.oneearth.org/category/croplands/> ;
    rdfs:subClassOf oes:Regenerative_Agriculture_Activity ;
    skos:definition "An activity involving managing crop production to improve soils, ecological resilience, and resource use."@en ;
    oes:framework_level oes:Subpillar_Level .

oes:Solution_Level a owl:NamedIndividual,
        oes:Framework_Level ;
    rdfs:label "Solution Level"@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    skos:definition "A named solution pathway at the most detailed level of this framework snapshot."@en .

<https://www.in2use.com/one_earth_solutions> a owl:Ontology ;
    rdfs:label "one earth solutions"@en ;
    dcterms:created "2026-11-11"^^xsd:date ;
    dcterms:creator "Michael DeBellis"@en ;
    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    dcterms:modified "2026-11-12"^^xsd:date ;
    dcterms:rights "Names, source hierarchy, and links are attributed to One Earth. Process semantics and concise draft descriptions were prepared for Common Action. This is not an official One Earth ontology. The license follows the existing project repository."@en ;
    dcterms:source <https://www.oneearth.org/categories/>,
        <https://www.oneearth.org/solutions/> ;
    dcterms:title "one_earth_solutions"@en ;
    rdfs:comment "Directly imports the Bioregions ontology, which embeds Big Bro, SULO, and PROV, together with the GeoSPARQL and what3words modules. No separate integration wrapper or full process-model ontology is required."@en,
        "The framework hierarchy denotes kinds of activity, not subprocess composition. Classes may overlap. A target denotes intended focus and does not assert successful impact, physical participation, location, or modification of an entire region. Six fictional demonstration individuals are flagged with is_illustrative_example."@en,
        "This draft interprets the 3 pillars, 12 subpillars, and 76 solution pathways as OWL classes of activities. The process interpretation and concise definitions are Common Action modeling choices, not claims that One Earth publishes an OWL process ontology. Original headings and source URLs are retained."@en ;
    owl:imports <https://raw.githubusercontent.com/mdebellis/One_Earth/main/ontologies/one_earth_bioregions/one_earth_bioregions.ttl>,
        <https://raw.githubusercontent.com/mdebellis/One_Earth/main/ontologies/one_earth_bioregions/one_earth_geosparql.ttl>,
        <https://raw.githubusercontent.com/mdebellis/One_Earth/main/ontologies/one_earth_bioregions/one_earth_what3words_examples.ttl> ;
    owl:versionInfo "0.2.2 - direct imports of Bioregions, GeoSPARQL, and what3words"@en ;
    skos:definition "A Common Action ontology of climate solution activities, based on One Earth’s framework and integrated with the One Earth Bioregions ontology and its Big Bro foundation."@en ;
    skos:editorialNote "Source hierarchy reviewed on 2026-11-11. The Renewable Power category page additionally lists Advanced Nuclear, absent from the main framework page. The 76 pathways follow the main framework pending source reconciliation."@en ;
    skos:historyNote "Version 0.2 replaces the standalone category-individual draft (0.1). Load this version instead of merging it with 0.1; some former category IRIs now identify classes and others have action-oriented replacements. No class/individual punning is intended."@en .

