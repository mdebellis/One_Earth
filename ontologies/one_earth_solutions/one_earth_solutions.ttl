oes:Example_Conservation_Fundraising a owl:NamedIndividual,
        oes:Climate_Fundraising ;
    rdfs:label "Example Conservation Fundraising"@en ;
    rdfs:comment "Fictional demonstration data created for Common Action. This does not describe a verified activity, organization, or ecosystem site."@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    skos:definition "A fictional fundraising activity situated in Britain and intended to support conservation in the Pacific Northwest."@en ;
    oes:has_lever_of_change oes:Finance_And_Incentives ;
    oes:has_location oeb:Great_Britain_Ireland_And_Faroe_Islands ;
    oes:has_responsible_agent oes:Example_Conservation_Organization ;
    oes:has_target oeb:Pacific_Northwest_Coastal_Forests ;
    oes:is_illustrative_example true .

oes:Example_Wetland_Restoration a owl:NamedIndividual,
        oes:Wetland_Restoration ;
    rdfs:label "Example Wetland Restoration"@en ;
    rdfs:comment "Fictional demonstration data created for Common Action. This does not describe a verified activity, organization, or ecosystem site."@en ;
    rdfs:isDefinedBy <https://www.in2use.com/one_earth_solutions> ;
    skos:definition "A fictional wetland restoration effort used to demonstrate activities, targets, and the imported region hierarchy."@en ;
    sulo:hasParticipant oes:Example_Conservation_Organization ;
    oes:has_intersectional_theme oes:Biological_Diversity,
        oes:Water_Stewardship ;
    oes:has_lever_of_change oes:Community_Action ;
    oes:has_location oeb:Pacific_Northwest_Coastal_Forests ;
    oes:has_responsible_agent oes:Example_Conservation_Organization ;
    oes:has_subprocess oes:Example_Habitat_Work ;
    oes:has_target oeb:Pacific_Northwest_Coastal_Forests,
        oes:Coho_Salmon,
        oes:Example_Wetland ;
    oes:is_illustrative_example true .

